import speech_recognition as sr
from gtts import gTTS
import pyaudio
import os
import time
import pygame
from googletrans import Translator  # Import Translator for text translation

def get_vb_audio_index():
    """Find VB-Cable device index."""
    audio = pyaudio.PyAudio()
    try:
        for index in range(audio.get_device_count()):
            device = audio.get_device_info_by_index(index)
            print(f"Device {index}: {device['name']}")
            if "VB-Audio" in device['name']:
                return index
        return None
    finally:
        audio.terminate()

def get_user_choice():
    print("Select language and accent:")
    print("1. US English (en-US)")
    print("2. British English (en-GB)")
    print("3. Indian English (en-IN)")
    print("4. Hindi (hi)")
    print("5. Telugu (te)")
    print("6. Kannada (kn)")

    choice = input("Enter choice (1-6): ")

    # Language and Accent Mapping
    accent_map = {
        '1': 'en-US',
        '2': 'en-GB',
        '3': 'en-IN',
    }

    language_map = {
        '4': 'hi',  # Hindi
        '5': 'te',  # Telugu
        '6': 'kn',  # Kannada
    }

    if choice in accent_map:
        accent = accent_map[choice]
        print(f"Selected accent: {accent}")
        return accent, None  # Accent chosen, no need for language

    elif choice in language_map:
        language = language_map[choice]
        print(f"Selected language: {language}")
        return None, language

    else:
        print("Invalid choice. Exiting.")
        exit(1)

def real_time_translation():
    vb_cable_index = get_vb_audio_index()
    if vb_cable_index is None:
        print("Error: VB-Cable device not found. Check your audio setup.")
        exit(1)

    print(f"VB-Cable found at index: {vb_cable_index}")

    try:
        accent, language = get_user_choice()

        recognizer = sr.Recognizer()
        translator = Translator()

        # Continuously listen for speech
        while True:
            print("Adjusting for ambient noise...")
            with sr.Microphone(device_index=vb_cable_index) as source:
                recognizer.adjust_for_ambient_noise(source, duration=5)
                print("Listening for your speech. Please speak now...")
                audio_data = recognizer.listen(source, timeout=10, phrase_time_limit=10)

            try:
                print("Recognizing speech...")
                recognized_text = recognizer.recognize_google(audio_data, language="en-US")
                print(f"Recognized Text: {recognized_text}")

                translated_text = recognized_text  # Default: no translation
                if language:
                    print(f"Translating to {language}...")
                    translated_text = translator.translate(recognized_text, dest=language).text
                    print(f"Translated Text: {translated_text}")

                # Convert translated text into speech
                print("Converting recognized text into speech...")
                tts_lang = accent if accent else language  # Use accent for TTS if available
                tts = gTTS(text=translated_text, lang=tts_lang)
                tts_output = f"output_{str(int(time.time()))}.mp3"  # Unique filename to avoid conflicts
                tts.save(tts_output)

                # Play the generated audio using pygame
                print("Playing the translated speech...")
                pygame.mixer.init()
                pygame.mixer.music.load(tts_output)
                pygame.mixer.music.play()

                # Wait until playback finishes
                while pygame.mixer.music.get_busy():
                    pygame.time.Clock().tick(10)  # Check every 10ms if music is still playing

                print("Playback finished.")

                # Clean up temporary files after playback
                pygame.mixer.quit()  # Ensure pygame resources are released
                time.sleep(1)  # Optional: Ensure a slight delay before deleting the file
                if os.path.exists(tts_output):
                    os.remove(tts_output)  # Clean up the generated audio file
                print("Temporary file removed.")

            except sr.WaitTimeoutError:
                print("Listening timed out while waiting for audio.")
            except sr.UnknownValueError:
                print("Could not understand the audio.")
            except sr.RequestError as e:
                print(f"API request failed: {e}")
            except Exception as e:
                print(f"An error occurred: {e}")

    except KeyboardInterrupt:
        print("Real-time translation stopped by user.")
    except Exception as e:
        print(f"An error occurred: {e}")

if __name__ == "__main__":
    real_time_translation()
